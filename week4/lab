#include <stdio.h>
int main(){
    double Salary=0.00;
    double Allowance1=0.00;
    double Allowance2=0.00;
    double Tax=0.00;
    double gross;
    double net;

    printf("Enter your Basic Salary:");
    scanf("%lf",&Salary);
    printf("Enter your Housing Allowance:");
    scanf("%lf",&Allowance1);
    printf("Enter your Transport Allowance:");
    scanf("%lf",&Allowance2);
    printf("Enter your TAX:");
    scanf("%lf",&Tax);

    gross=Salary+Allowance1+Allowance2;
    printf("Gross Salary: %.2f", gross);
    net=gross-Tax;
    printf("\nNet Salary: %.2f", net);
    
    return 0;
}